{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "include": [
        "src/**/*.csproj",
        "tests/fixtures/**/*.csproj",
        "tests/architecture/**/*Rules.csproj"
      ],
      "options": {
        "restore": true,
        "test": false
      }
    },
    {
      "plugin": "@nx/dotnet",
      "include": ["tests/unit/**/*.csproj", "tests/architecture/**/*Tests.csproj"],
      "options": {
        "restore": true,
        "test": {
          "targetName": "test"
        }
      }
    },
    {
      "plugin": "@nx/dotnet",
      "include": ["tests/integration/**/*.csproj"],
      "options": {
        "restore": true,
        "test": {
          "targetName": "test:integration"
        }
      }
    },
    {
      "plugin": "@nx/dotnet",
      "include": ["tests/e2e/web/**/*.csproj"],
      "options": {
        "restore": true,
        "test": {
          "targetName": "test:e2e"
        }
      }
    },
    {
      "plugin": "@nx/dotnet",
      "include": ["tests/e2e/kubernetes/**/*.csproj"],
      "options": {
        "restore": true,
        "test": {
          "targetName": "test:kubernetes"
        }
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "include": ["src/apps/keycloak-theme/vite.config.ts"],
      "options": {
        "buildTargetName": "build",
        "typecheckTargetName": false
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "include": ["src/apps/storefront/next.config.*", "src/apps/admin/next.config.*"]
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "commerceContract": [
      "{workspaceRoot}/docs/contracts/commerce/v1/customer.openapi.yaml",
      "{workspaceRoot}/docs/contracts/commerce/v1/admin.openapi.yaml"
    ],
    "designTokensSource": [
      "{workspaceRoot}/src/packages/design-tokens/tokens.json",
      "{workspaceRoot}/src/packages/design-tokens/tokens.css",
      "{workspaceRoot}/src/packages/design-tokens/tokens.css.d.ts",
      "{workspaceRoot}/src/packages/design-tokens/index.js",
      "{workspaceRoot}/src/packages/design-tokens/index.d.ts"
    ],
    "workspaceDependencies": ["{workspaceRoot}/package.json", "{workspaceRoot}/bun.lock"],
    "sharedGlobals": [
      "{workspaceRoot}/.editorconfig",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/Directory.Build.props",
      "{workspaceRoot}/Directory.Packages.props",
      "{workspaceRoot}/nuget.config",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/stylecop.json",
      "{workspaceRoot}/tools/verify-wolverine-static.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:kubernetes": {
      "dependsOn": ["build"],
      "cache": false
    },
    "container:build": {
      "dependsOn": ["build"],
      "cache": false
    },
    "container:push": {
      "dependsOn": ["container:build"],
      "cache": false
    }
  }
}
