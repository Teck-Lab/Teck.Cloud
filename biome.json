{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/bin",
      "!**/obj",
      "!**/dist",
      "!**/.next",
      "!**/.expo",
      "!**/node_modules",
      "!**/.nx",
      "!**/.artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/packages.lock.json", "**/packages.static.lock.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
