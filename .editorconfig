root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
# Promote enabled third-party suggestions too; SDK CA rules use 10.0-recommended.
dotnet_analyzer_diagnostic.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
# Performance and async correctness beyond the SDK recommended baseline.
dotnet_diagnostic.CA1848.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2016.severity = warning

# Public API documentation is enforced by StyleCop, including with CS1591 suppressed.
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1611.severity = warning
dotnet_diagnostic.SA1615.severity = warning

# Deliberate style choices; keep all other analyzer defaults active.
# No required this. prefix, underscore fields are allowed, no copyright banners.
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1636.severity = none

# Compiler-generated sources still compile; tooling skips authoring-style checks.
[*.{g,g.i,generated,Designer}.cs]
generated_code = true

# xUnit/MTP-generated startup excludes itself from coverage without a justification.
# Keep compiler and other diagnostics enabled; this rule is not actionable in generated code.
[**/obj/**/{SelfRegisteredExtensions,XunitAutoGeneratedEntryPoint}.cs]
generated_code = true
dotnet_diagnostic.EPC29.severity = none
