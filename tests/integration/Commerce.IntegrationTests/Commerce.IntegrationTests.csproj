<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>Commerce.IntegrationTests</RootNamespace>
    <GenerateCommerceHandlers Condition="'$(GenerateCommerceHandlers)' == ''">false</GenerateCommerceHandlers>
  </PropertyGroup>
  <ItemGroup Condition="'$(GenerateCommerceHandlers)' != 'true'">
    <Compile Remove="Infrastructure/CommerceHandlerGeneration.cs" />
    <Compile Remove="Tests/CommerceHandlerGenerationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Standard.Licensing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/shared/Commerce.Contracts/Commerce.Contracts.csproj" />
    <ProjectReference Include="../../../src/shared/SharedKernel.Infrastructure/SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="../../../src/services/commerce/orders/Orders.Host/Orders.Host.csproj" />
    <ProjectReference Include="../../../src/services/commerce/licensing/Licensing.Host/Licensing.Host.csproj" />
    <ProjectReference Include="../../../src/services/gateway/customer-gateway/CustomerGateway.Host/CustomerGateway.Host.csproj" />
    <ProjectReference Include="../../../src/services/gateway/admin-gateway/AdminGateway.Host/AdminGateway.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../src/aspire/Teck.Cloud.AppHost/Identity/**/*" Link="Identity/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../docs/contracts/commerce/v1/*.openapi.yaml" Link="Contracts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
