<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Teck.Cloud.Commerce.Licensing.Host</AssemblyName>
    <RootNamespace>Teck.Cloud.Commerce.Licensing.Host</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages.codegen.lock.json</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CommerceWolverineCodegen)' == 'true'">
    <DefineConstants>$(DefineConstants);COMMERCE_WOLVERINE_CODEGEN</DefineConstants>
    <NuGetLockFilePath>packages.codegen.lock.json</NuGetLockFilePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);Internal/Generated/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Keycloak.AuthServices.Sdk.Kiota" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <ProjectReference Include="../../../../shared/Commerce.Contracts/Commerce.Contracts.csproj" />
    <ProjectReference Include="../../../../shared/SharedKernel.Infrastructure/SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="../Licensing.Application/Licensing.Application.csproj" />
    <ProjectReference Include="../Licensing.Infrastructure/Licensing.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CommerceWolverineCodegen)' == 'true'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RejectCommerceCodegenPublish" BeforeTargets="PrepareForPublish" Condition="'$(CommerceWolverineCodegen)' == 'true'">
    <Error Code="TECKCOMMERCE001" Text="Commerce handler generation build cannot be published." />
  </Target>
</Project>
