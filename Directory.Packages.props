    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.64.0" />
    <PackageVersion Include="Ardalis.Specification" Version="9.3.1" />
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1" />
